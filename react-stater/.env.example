# =============================================================================
# Goong Map Configuration (Recommended Vietnam Provider - https://account.goong.io)
# =============================================================================
# 1. Goong MapTiles Key (Used to render crisp vector map tiles with MapLibre GL)
#    Get your free MapTiles Key at: https://account.goong.io/keys
VITE_GOONG_MAPTILES_KEY=

# 2. Goong REST API Key (Used for Place Autocomplete & Geocoding in Vietnam)
#    Get your free API Key at: https://account.goong.io/keys
VITE_GOONG_API_KEY=

# =============================================================================
# NexSpace API & Mock Server Configuration
# =============================================================================
# Base URL for frontend API client. Default is '/api/v1' (proxied via Vite)
# Or set directly to 'http://localhost:4000/api/v1' for direct communication.
VITE_API_BASE_URL=/api/v1

# Target port for the standalone Mock REST Server (default: 4000)
MOCK_SERVER_PORT=4000

# Proxy target for Vite dev server (default: http://localhost:4000)
VITE_API_PROXY_TARGET=http://localhost:4000
