# ==============================================================================
# NexSpace Backend — Local Development Configuration Template
# ==============================================================================
# Copy this file to application-local.properties (gitignored) and customize:
#   cp application-local.properties.example application-local.properties
# Or run ./sync-config.sh (macOS/Linux) or sync-config.bat (Windows) to pull from Secret Gist.
# ==============================================================================

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/nexspace_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
spring.datasource.username=root
spring.datasource.password=password

# ── Database Migration (Flyway) ──────────────────────────────────────────────
# Automatically runs src/main/resources/db/migration/V1__init_schema.sql on startup.
# Use scripts/db/init_data.py to seed business data and scripts/db/clear_data.py to reset.
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# ── Security & Authentication ────────────────────────────────────────────────
# Secret must be at least 32 characters (HS256)
app.jwt.secret=NexSpaceSuperSecureSecretKeyThatIsAtLeast32BytesLong!2026
app.jwt.expiration-ms=86400000

# Organizer sensitive bank account cipher key (AES-256)
app.organizer.bank.encryption-key=NexSpaceOrganizerBankKey32Bytes!

# ── Cloudinary Media Storage (Optional, auto-fallback to local storage) ─────
# Get free credentials at: https://cloudinary.com/users/register_free
# cloudinary.cloud-name=your_cloud_name
# cloudinary.api-key=your_api_key
# cloudinary.api-secret=your_api_secret
# cloudinary.folder.nexspace=nexspace
# cloudinary.folder.nexspace.workspace=nexspace/workspaces/{id}

# ── Mail Service (SMTP) ──────────────────────────────────────────────────────
# Optional — only needed when app.auth.email-verification-enabled=true or for password reset
# spring.mail.username=your-email@gmail.com
# spring.mail.password=your-gmail-app-password

# ── Application URLs & Features (Optional overrides) ─────────────────────────
# app.auth.email-verification-enabled=true
# app.auth.inactive-threshold-days=90
# app.client-url=http://localhost:3000
# app.api-url=http://localhost:8080
# Local-only demonstration agreement. Never use this template for real transactions.
app.organizer.contract.demo-enabled=true
# Floor design assistant. Keep the real API key in the ignored Local file only.
nexspace.floor-ai.gemini-api-key=${GEMINI_API_KEY:}
nexspace.floor-ai.model=${GEMINI_MODEL:gemini-3.6-flash}

# ── PayOS Payment Gateway Configuration (Kênh thu tiền thanh toán) ───────────
# Lấy bộ key kênh thu tại: https://my.payos.vn/
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:3000/workspaces/confirmation
PAYOS_CANCEL_URL=http://localhost:3000/workspaces/review

# ── PayOS Payout Configuration (Kênh chi tiền hoàn tự động) ──────────────────
# Lấy bộ key kênh chi riêng biệt tại portal PayOS (Kênh chi).
# Lưu ý: Bắt buộc cấu hình Whitelist IP máy chủ gọi API trên my.payos.vn.
PAYOS_PAYOUT_CLIENT_ID=your-payos-payout-client-id
PAYOS_PAYOUT_API_KEY=your-payos-payout-api-key
PAYOS_PAYOUT_CHECKSUM_KEY=your-payos-payout-checksum-key



