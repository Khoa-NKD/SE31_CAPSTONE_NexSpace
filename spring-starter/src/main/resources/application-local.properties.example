# ==============================================================================
# NexSpace Backend — Local Development Configuration Template
# ==============================================================================
# Copy this file to application-local.properties (gitignored) and customize:
#   cp application-local.properties.example application-local.properties
# Or run ./sync-config.sh (macOS/Linux) or sync-config.bat (Windows) to pull from Secret Gist.
# ==============================================================================

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/nexspace_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
spring.datasource.username=root
spring.datasource.password=password

# ── Security & Authentication ────────────────────────────────────────────────
# Secret must be at least 32 characters (HS256)
app.jwt.secret=NexSpaceSuperSecureSecretKeyThatIsAtLeast32BytesLong!2026
app.jwt.expiration-ms=86400000

# Initial seeded administrative credentials on first database startup
app.seed.admin.password=Admin@123456
app.seed.organizer.password=Organizer@123456

# Organizer sensitive bank account cipher key (AES-256)
app.organizer.bank.encryption-key=NexSpaceOrganizerBankKey32Bytes!

# ── Cloudinary Media Storage (Optional, auto-fallback to local storage) ─────
# Get free credentials at: https://cloudinary.com/users/register_free
# cloudinary.cloud-name=your_cloud_name
# cloudinary.api-key=your_api_key
# cloudinary.api-secret=your_api_secret
# cloudinary.folder.nexspace=nexspace
# cloudinary.folder.nexspace.workspace=nexspace/workspaces/{id}

# ── Mail Service (SMTP) ──────────────────────────────────────────────────────
# Optional — only needed when app.auth.email-verification-enabled=true or for password reset
# spring.mail.username=your-email@gmail.com
# spring.mail.password=your-gmail-app-password

# ── Application URLs & Features (Optional overrides) ─────────────────────────
# app.auth.email-verification-enabled=true
# app.client-url=http://localhost:3000
# app.api-url=http://localhost:8080
