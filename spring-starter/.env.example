SERVER_PORT=8080
DB_URL=jdbc:mysql://mysql:3306/MOCK_PROJECT_NEXSPACE?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USERNAME=nexspace
DB_PASSWORD=<local database password>
JWT_SECRET=<random string, at least 32 bytes>
JWT_EXPIRATION_MS=900000
CLIENT_URL=https://your-frontend.example.com
API_URL=https://api.your-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
EMAIL_VERIFICATION_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PASSWORD=<initial admin password>
MAIL_USERNAME=
MAIL_PASSWORD=

# MySQL Docker Compose service (choose local passwords before starting).
MYSQL_DATABASE=MOCK_PROJECT_NEXSPACE
MYSQL_USER=nexspace
MYSQL_PASSWORD=<local database password>
MYSQL_ROOT_PASSWORD=<local root password>
MYSQL_PORT=3307

# Compose runs the prod profile. For a local-only smoke test without SMTP, set email verification false.
SWAGGER_ENABLED=false
